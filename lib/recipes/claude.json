{
  "id": "claude",
  "label": "Claude Code",
  "vendor": "Anthropic",
  "cost": "paid",
  "homepage": "https://claude.com/claude-code",
  "notes": "Recent versions ship a NATIVE binary (npm bin -> bin/claude.exe on Windows), so the bin shim (.ps1/.cmd) must not be spawned directly — discover.derive resolves the real entry next to it. Print mode returns ONE json object: answer=.result, session=.session_id, cost=.total_cost_usd, tokens=.usage.*. A failing run still exits 0 with is_error=true, which output.errorFlag catches. PAID: every run spends the user's credits (a three-word answer measured $0.094 on 2026-09-30).",

  "discover": {
    "env": ["CLAUDE_CLI"],
    "bin": ["claude"],
    "paths": {
      "win32": [
        "%APPDATA%\\npm\\node_modules\\@anthropic-ai\\claude-code\\bin\\claude.exe",
        "%LOCALAPPDATA%\\Programs\\claude\\claude.exe"
      ],
      "darwin": [
        "/opt/homebrew/bin/claude",
        "/usr/local/bin/claude",
        "~/.claude/local/claude"
      ],
      "linux": [
        "/usr/local/bin/claude",
        "~/.claude/local/claude",
        "~/.local/bin/claude"
      ]
    },
    "derive": [
      { "platforms": ["win32"], "append": "node_modules/@anthropic-ai/claude-code/bin/claude.exe" },
      { "append": "node_modules/@anthropic-ai/claude-code/bin/claude" }
    ]
  },

  "version": {
    "args": ["--version"],
    "match": "claude",
    "timeoutMs": 60000
  },

  "run": {
    "argv": ["-p", "--output-format", "json"],
    "prompt": { "via": "positional" },
    "model": { "flag": ["--model"] },
    "session": { "flag": ["--resume"] },
    "resume": { "flag": ["-c"] },
    "workdir": { "via": "cwd" }
  },

  "output": {
    "format": "json",
    "answer": { "pick": "result" },
    "session": { "pick": "session_id" },
    "errorFlag": "is_error",
    "usage": {
      "steps": "num_turns",
      "cost": "total_cost_usd",
      "input": "usage.input_tokens",
      "output": "usage.output_tokens",
      "reasoning": "usage.output_tokens_details.thinking_tokens",
      "cacheRead": "usage.cache_read_input_tokens"
    }
  },

  "caps": {
    "model": true,
    "session": true,
    "resume": true,
    "files": false,
    "autoApprove": true,
    "structured": true
  },

  "safety": {
    "autoApproveFlag": "--dangerously-skip-permissions",
    "note": "Print mode (-p) answers without prompting for the read-only case. Anything that would touch the filesystem needs an explicit permission flag, which this recipe deliberately does NOT pass: the bridge must not silently grant write access."
  }
}
